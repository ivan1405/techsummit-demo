# Copy to .env and adjust. Everything works without an LLM key (demo mode).

# none | openai | anthropic
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
# Leave empty for the model default (required for claude-sonnet-5-5 and gpt-5 models)
LLM_TEMPERATURE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only when the key belongs to a gateway/proxy instead of the public API:
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

# Set to http://marquez:5000 when running with --profile marquez
OPENLINEAGE_URL=

# Confluence Cloud for source schemas and plan publishing. Empty = the bundled mock (http://localhost:8095).
# CONFLUENCE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE=DATA

# PII: the MCP server masks personal data (emails, names, ...) for the reader role. The agent unlocks the
# analyst role with this shared token. Compose defaults it to a demo value when unset: set your own secret,
# or set it to an empty value (MCP_ANALYST_TOKEN=) to force masking for everyone.
# MCP_ANALYST_TOKEN=change-me

# Scheduled runs: run the pipeline every N minutes (0 = off; can also be changed in the Run history tab).
# SCHEDULE_MINUTES=0
# Optional webhook (e.g. a Slack incoming webhook) that receives each run's alerts.
# ALERT_WEBHOOK_URL=
